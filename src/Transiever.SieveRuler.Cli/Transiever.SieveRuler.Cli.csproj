<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>srtx</AssemblyName>
    <RootNamespace>Transiever.SieveRuler.Cli</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>srtx</ToolCommandName>
    <PackageId>Transiever.SieveRuler.Cli</PackageId>
    <Description>Cross-platform .NET CLI and global tool for generating, previewing, reconciling, and deploying Sieve rules from JSON.</Description>
    <PackageTags>transiever;sieve;sieve-script;managesieve;email-filtering;mail-rules;dotnet;csharp;json;cli;tool;dotnet-tool</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageProjectUrl>https://sewieland.github.io/transiever/dotnet-sieve-rules/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SeWieland/Transiever.SieveRuler</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Transiever.SieveRuler\Transiever.SieveRuler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

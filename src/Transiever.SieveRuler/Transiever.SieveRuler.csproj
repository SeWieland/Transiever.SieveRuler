<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Title>Transiever.SieveRuler</Title>
    <Description>.NET 10 library for JSON mail rules, Sieve generation and reconciliation, and safe ManageSieve deployment.</Description>
    <PackageTags>transiever;sieve;sieve-script;managesieve;email-filtering;mail-rules;dotnet;csharp;json;json-schema</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageProjectUrl>https://sewieland.github.io/transiever/dotnet-sieve-rules/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SeWieland/Transiever.SieveRuler</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <ManageSieveProject>..\..\..\ManageSieve\src\Transiever.ManageSieve\Transiever.ManageSieve.csproj</ManageSieveProject>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ManageSieveProject)')">
    <ProjectReference Include="$(ManageSieveProject)" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(ManageSieveProject)')">
    <PackageReference Include="Transiever.ManageSieve" Version="1.1.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\schemas\sieveruler.rules.schema.json"
          Pack="true"
          PackagePath="schemas\" />
  </ItemGroup>

</Project>
